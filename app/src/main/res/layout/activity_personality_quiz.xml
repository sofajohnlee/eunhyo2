<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="놀이형 성향 테스트"
            android:textAppearance="@style/TextAppearance.Material3.HeadlineMedium" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="교육용 놀이 기능이며 심리검사나 진단이 아닙니다." />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchQ1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="사람들과 함께하는 활동을 좋아한다" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchQ2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="새로운 생각과 가능성을 떠올리는 것을 좋아한다" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchQ3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="결정할 때 논리와 기준을 중요하게 생각한다" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchQ4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="계획을 정해 두고 진행하는 것을 좋아한다" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="결과 보기" />

        <TextView
            android:id="@+id/textResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.Material3.TitleLarge" />
    </LinearLayout>
</ScrollView>
