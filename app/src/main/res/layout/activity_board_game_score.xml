<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="보드게임 점수"
            android:textAppearance="@style/TextAppearance.Material3.HeadlineMedium" />

        <EditText
            android:id="@+id/editKnight1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:hint="기사 항목 1"
            android:inputType="number" />

        <EditText
            android:id="@+id/editKnight2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="기사 항목 2"
            android:inputType="number" />

        <CheckBox
            android:id="@+id/checkDoubleKnight"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="기사 점수 2배" />

        <TextView
            android:id="@+id/textKnightScore"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="28sp" />

        <EditText
            android:id="@+id/editFarmer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:hint="농부 항목"
            android:inputType="number" />

        <TextView
            android:id="@+id/textFarmerScore"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="28sp" />
    </LinearLayout>
</ScrollView>
