<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="학습 편지장"
            android:textAppearance="@style/TextAppearance.Material3.HeadlineMedium" />

        <TextView
            android:id="@+id/textDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonImportReceived"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="받은 편지 텍스트 파일 열기" />

        <TextView
            android:id="@+id/textReceived"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minHeight="96dp"
            android:padding="12dp"
            android:text="받은 편지가 없습니다."
            android:textIsSelectable="true" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonReadReceived"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="받은 편지 읽어주기" />

        <EditText
            android:id="@+id/editOutgoing"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="top|start"
            android:hint="오늘의 학습 내용이나 편지를 작성하세요"
            android:inputType="textCapSentences|textMultiLine"
            android:minHeight="140dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonVoiceInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="음성으로 입력" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonSaveOutgoing"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="오늘 편지 저장" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonClearOutgoing"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="입력 지우기" />
    </LinearLayout>
</ScrollView>
