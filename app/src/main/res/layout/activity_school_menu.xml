<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView android:id="@+id/textSchoolLevel" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textAppearance="@style/TextAppearance.Material3.HeadlineMedium" />
        <com.google.android.material.button.MaterialButton android:id="@+id/buttonKorean" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="국어·한글" />
        <com.google.android.material.button.MaterialButton android:id="@+id/buttonKoreanPhrase" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="국어 문장" />
        <com.google.android.material.button.MaterialButton android:id="@+id/buttonKoreanIdiom" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="속담·관용어" />
        <com.google.android.material.button.MaterialButton android:id="@+id/buttonKoreanSpelling" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="한글 맞춤법" />
        <com.google.android.material.button.MaterialButton android:id="@+id/buttonKoreanPronunciation" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="표준발음법" />
        <com.google.android.material.button.MaterialButton android:id="@+id/buttonKoreanBook" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="국어 책" />
        <com.google.android.material.button.MaterialButton android:id="@+id/buttonKoreanSong" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="국어 노래" />
        <com.google.android.material.button.MaterialButton android:id="@+id/buttonEnglish" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="영어" />
        <com.google.android.material.button.MaterialButton android:id="@+id/buttonAlphabetTrace" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="알파벳 따라쓰기" />
        <com.google.android.material.button.MaterialButton android:id="@+id/buttonEnglishWord" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="영어 단어 따라쓰기" />
        <com.google.android.material.button.MaterialButton android:id="@+id/buttonEnglishSentence" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="영어 문장 CSV" />
        <com.google.android.material.button.MaterialButton android:id="@+id/buttonTyping" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="한글·영문 타자연습" />
        <com.google.android.material.button.MaterialButton android:id="@+id/buttonMath" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="수학" />
        <com.google.android.material.button.MaterialButton android:id="@+id/buttonMathProgress" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="수학 학습현황" />
        <com.google.android.material.button.MaterialButton android:id="@+id/buttonMathState" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="수학 상태 설정" />
        <com.google.android.material.button.MaterialButton android:id="@+id/buttonMeasurement" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="길이·시간·달력 환산" />
        <com.google.android.material.button.MaterialButton android:id="@+id/buttonGcdLcm" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="최대공약수·최소공배수" />
        <com.google.android.material.button.MaterialButton android:id="@+id/buttonGeometry" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="기하 도형" />
        <com.google.android.material.button.MaterialButton android:id="@+id/buttonLegacyGallery" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="원본 그림 학습자료" />
        <com.google.android.material.button.MaterialButton android:id="@+id/buttonLegacySlideshow" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="원본 슬라이드 학습" />
        <com.google.android.material.button.MaterialButton android:id="@+id/buttonGraph" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="그래프 도구" />
        <com.google.android.material.button.MaterialButton android:id="@+id/buttonHanja" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="한자" />
        <com.google.android.material.button.MaterialButton android:id="@+id/buttonHanjaRadical" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="한자 부수" />
        <com.google.android.material.button.MaterialButton android:id="@+id/buttonHistory" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="역사" />
        <com.google.android.material.button.MaterialButton android:id="@+id/buttonWorld" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="세계 국가 학습" />
        <com.google.android.material.button.MaterialButton android:id="@+id/buttonClock" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="시계 학습" />
        <com.google.android.material.button.MaterialButton android:id="@+id/buttonDrawing" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="그리기 연습" />
        <com.google.android.material.button.MaterialButton android:id="@+id/buttonLinks" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="교육 사이트" />
        <com.google.android.material.button.MaterialButton android:id="@+id/buttonStudyMail" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="학습 편지장" />
        <com.google.android.material.button.MaterialButton android:id="@+id/buttonMedia" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="미디어 학습" />
        <com.google.android.material.button.MaterialButton android:id="@+id/buttonSports" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="스포츠 학습" />
        <com.google.android.material.button.MaterialButton android:id="@+id/buttonMagic" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="마술 영상" />
        <com.google.android.material.button.MaterialButton android:id="@+id/buttonGoldenBell" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="골든벨 O/X" />
        <com.google.android.material.button.MaterialButton android:id="@+id/buttonPersonality" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="놀이형 성향 테스트" />
        <com.google.android.material.button.MaterialButton android:id="@+id/buttonMaze" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="미로 게임" />
        <com.google.android.material.button.MaterialButton android:id="@+id/buttonAi" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="AI 학습 도우미" />
        <com.google.android.material.button.MaterialButton android:id="@+id/buttonGame" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="게임·점수" />
    </LinearLayout>
</ScrollView>
